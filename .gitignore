# Build output
bin/
dist/
*.test
*.out
# Compiled binaries take the name of their directory, so `go build ./...` inside a
# service leaves one next to the source. One reached a commit that way.
/app/app
/gate/gate
/exporter/exporter
/dashboard/dashboard
/pricing/pricing

# Local cluster / tooling state
kubeconfig
*.kubeconfig
.tmp/
.cache/

# Secrets, never committed. See docs/adr/0004-secret-handling.md
.env
*.local.yaml
!*.example.yaml

# OS / editor
.DS_Store
.idea/
.vscode/

# wrangler local state
.wrangler/
